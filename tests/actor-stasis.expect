# The log of the test must have a line for each of these patterns (grep -E).
# Far from the player, a soldier that wanders is in stasis and does not move. Its place is 1 unit from its start
# place (-6009 1735), because it made one step before it went into stasis. A soldier that wanders goes about 25
# units in each second.
\[3\.00\].* dump UNATCOTroop2 state=Wandering loc=\(-60[01][0-9] 17[23][0-9] -99\) .* inStasis
\[6\.00\].* dump UNATCOTroop2 state=Wandering loc=\(-60[01][0-9] 17[23][0-9] -99\) .* inStasis
# A security computer in stasis did not run its start code, which turns it off.
\[3\.20\].* dump ComputerSecurity0 state=Off .* inStasis bOn=True
# Three medical bots are in stasis. They go away when they become transient.
\[3\.10\].* dump MedicalBot0 .* inStasis .* bTransient=False
\[3\.10\].* dump MedicalBot1 .* inStasis .* bTransient=False
\[3\.10\].* dump MedicalBot3 .* inStasis .* bTransient=False
!\[6\.50\].* dump MedicalBot[013] 
# The player is near the soldier now. The soldier is out of stasis, and the computer behind the wall ran its start code.
# The test puts the player 300 units from the soldier. The soldier wanders again, so the distance changes by some units.
\[7\.20\].* dump UNATCOTroop2 .* dist=(29[0-9]|30[0-9]) 
!\[7\.20\].* dump UNATCOTroop2 .* inStasis
!\[11\.00\].* dump UNATCOTroop2 .* inStasis
\[11\.10\].* dump ComputerSecurity0 state=Off .* bOn=False
# A computer that is far away stays in stasis.
\[11\.10\].* dump ComputerSecurity1 state=Off .* inStasis bOn=True
