# The log of the test must have a line for each of these patterns (grep -E).
# The player walks while the key is down, and the inventory opens.
\[3\.60\].* JCDentonMale0 .* loc=\(-4649 10431 -259\)
\[4\.50\].* PersonaScreenInventory 
# After the inventory closes, the player stops and stays at the same place.
\[6\.50\].* JCDentonMale0 state=PlayerWalking loc=\(-4592 10431 -259\)
\[10\.50\].* JCDentonMale0 state=PlayerWalking loc=\(-4592 10431 -259\)
# A key down event that repeats does not toggle the walk mode a second time.
\[11\.40\].* JCDentonMale0 .* bToggleWalk=True
