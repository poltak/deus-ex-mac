# The log of the test must have a line for each of these patterns (grep -E).
# The crouch works next to the door: the player is 16 units high, and the feet are on the floor at z = -143.
\[3\.00\].* dump JCDentonMale0 .* loc=\(1875 -1098 -127\) .* CollisionHeight=16\.000000 bIsCrouching=True
# The lowest beam sounds the alarm. The place of the alarm is on the floor, 1 unit above the feet of the player.
\[5\.80\].* dump LaserTrigger4 .* AmbientSound=Sound'Klaxon2' actorLocation=\(X=1875\.[0-9]+, Y=-9[0-9]{2}\.[0-9]+, Z=-142\.000000\)
# Four guards hear the alarm and go to its place
\[7\.00\].* dump Terrorist30 state=Seeking .* AlarmTimer=11[0-9]\.
\[7\.00\].* dump Terrorist2 state=Seeking .* AlarmTimer=11[0-9]\.
\[7\.00\].* dump Terrorist18 state=Seeking 
\[7\.00\].* dump Terrorist14 state=Seeking 
# After 8 seconds two guards that patrolled more than 500 units away are less than 400 units from the player
\[14\.00\].* dump Terrorist30 .* dist=([0-9]{1,2}|[1-3][0-9]{2}) 
\[14\.00\].* dump Terrorist2 .* dist=([0-9]{1,2}|[1-3][0-9]{2}) 
